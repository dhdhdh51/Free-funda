# BharatAI Business OS - Environment Configuration Example
# Copy this file to .env on your server and update with your actual credentials.

# Application Settings
APP_NAME="BharatAI Business OS"
APP_ENV=production
APP_KEY=base64:c29tZXJhbmRvbTI1NmJpdHNlY3JldGtleWZvcmFwcA==
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

# MySQL Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bharatai_saas
DB_USERNAME=bharatai_user
DB_PASSWORD=your_secure_db_password_here
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# AI Provider Credentials (Encrypted/Stored in Database or via Environment)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-3.7-flash

# SMTP Email Configuration
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=postmaster@yourdomain.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="BharatAI Business OS"

# Google OAuth Configuration (Dynamic with Auto-Detected Fallback)
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback.php

# Payment Gateway Configuration
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
STRIPE_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# Cron & System Security
CRON_SECRET_KEY=bharat_cron_secret_789456123
SESSION_LIFETIME=7200
SECURE_COOKIES=true
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME_MINUTES=15
